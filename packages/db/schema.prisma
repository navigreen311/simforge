// SimForge data layer — single source of truth for TS + Python types.
// Blueprint §B.1. 17 entities. Do not drift Python and TS models from this file.

generator client {
  provider = "prisma-client-js"
  output   = "../../apps/web/src/lib/db/generated"
}

generator pyclient {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// AGENT / ORGANIZATION
// ═══════════════════════════════════════════════════════════════

model Agent {
  id                   String     @id @default(cuid())
  villageAgentId       String     @unique // "taylor_zhang"
  name                 String
  role                 String
  departmentId         String
  department           Department @relation(fields: [departmentId], references: [id])
  gardnerFlag          Boolean    @default(false)
  level10Enabled       Boolean    @default(false) // perception + host cognition + phone
  currentAutonomyLevel String     @default("L1") // L1-L5

  agentCerts         AgentCert[]
  runs               Run[]
  cognitiveSnapshots CognitiveSnapshot[]
  autonomyEvents     AutonomyEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villageAgentId])
  @@index([departmentId])
  @@index([currentAutonomyLevel])
}

model Department {
  id          String @id @default(cuid())
  villageKey  String @unique // "Engineering"
  name        String
  totalAgents Int

  agents    Agent[]
  deptCerts DeptCert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// PACK & SCENARIO
// ═══════════════════════════════════════════════════════════════

model Venture {
  id                     String   @id @default(cuid())
  slug                   String   @unique // canonical id, e.g. "medlink-pro"
  name                   String
  description            String   @default("")
  status                 String   @default("in_development") // active | in_development | archived
  scenarioCode           String // scn.{scenarioCode}.{family}.{nnn}
  defaultComplianceFlags String[]
  internalForges         String[]
  capabilities           String[]
  createdBy              String   @default("system")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  packs Pack[]
  specDocuments SpecDocument[]

  @@index([status])
}

model SpecDocument {
  id                  String   @id @default(cuid())
  ventureSlug         String
  venture             Venture  @relation(fields: [ventureSlug], references: [slug])
  filename            String
  extractedText       String   @default("")
  enrichmentProposal  Json?
  producedScenarioIds String[]
  uploadedBy          String   @default("unknown")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([ventureSlug])
}

// A gated go-live Dress Rehearsal run (§15): entry/exit criteria snapshots + signed sign-offs.
model DressRehearsal {
  id           String   @id @default(cuid())
  packId       String
  status       String   @default("open")
  entryResults Json     @default("{}")
  exitResults  Json     @default("{}")
  signoffs     Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([packId])
}

// Golden Benchmark Bank governance (§12.5): promotion to the immutable gold set requires formal
// nomination + multi-party council review (an ApprovalRequest) + a recorded freeze. The nomination
// row is the durable governance record; Scenario.isGolden flips only when the request is approved.
model GoldenNomination {
  id                    String    @id @default(cuid())
  scenarioId            String
  nominatedBy           String
  rationale             String    @default("")
  interRaterReliability Float?
  approvalRequestId     String?
  status                String    @default("pending")
  frozenAt              DateTime?
  frozenBy              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([scenarioId])
  @@index([status])
}

// Multi-agent handoff integrity testing (v1.1). A department-level test of a cross-agent process:
// an ordered chain of handoffs, checked for completeness, continuity, and consent preservation.
model HandoffTest {
  id         String   @id @default(cuid())
  name       String
  scenarioId String?
  chain      Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([scenarioId])
}

// Knowledge Graph / Domain Ontology per venture (v1.1). The entities and relationships that define a
// venture's world, so scenarios can be grounded in (and checked against) a real domain model.
model OntologyEntity {
  id          String   @id @default(cuid())
  venture     String
  name        String
  category    String   @default("concept")
  description String   @default("")
  createdAt   DateTime @default(now())

  @@unique([venture, name])
}

model OntologyRelation {
  id         String   @id @default(cuid())
  venture    String
  fromEntity String
  relation   String
  toEntity   String
  createdAt  DateTime @default(now())

  @@index([venture])
}

// Temporal Realism Engine (v1.1). A reusable definition of time-based scenario dynamics: scheduled
// events (delayed/async) and time-bombs (a deadline turn + a defuse action + a consequence).
model TemporalScenario {
  id         String   @id @default(cuid())
  name       String
  scenarioId String?
  events     Json     @default("[]")
  timeBombs  Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([scenarioId])
}

// Production Outcome Correlation (v1.1). Real production performance per agent × forge capability,
// so certification scores can be correlated against production reality (miscalibration detection).
model ProductionOutcome {
  id             String   @id @default(cuid())
  agentVillageId String
  forgeCap       String
  outcomeScore   Float
  period         String   @default("")
  sampleSize     Int      @default(0)
  source         String   @default("manual")
  notes          String?
  recordedAt     DateTime @default(now())
  recordedBy     String   @default("system")

  @@index([agentVillageId])
  @@index([forgeCap])
}

// Scenario Truth Review Gate (v1.1). A per-scenario attestation that the scenario faithfully
// represents reality (realistic, correct expected outcome, no fabrication, accurate compliance)
// before it may certify agents. Approved only when every checklist item holds.
model ScenarioTruthReview {
  id         String    @id @default(cuid())
  scenarioId String    @unique
  status     String    @default("pending")
  checklist  Json      @default("{}")
  reviewer   String?
  notes      String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Sandbox-vs-production parity SLA (v1.1). Each row is a parity measurement for a forge capability;
// a score below the SLA marks the forge unsafe_to_certify (annotated always, enforced under a flag).
model ForgeParity {
  id              String   @id @default(cuid())
  forgeCap        String
  parityScore     Float
  slaThreshold    Float
  unsafeToCertify Boolean  @default(false)
  sampleSize      Int      @default(0)
  method          String   @default("manual")
  notes           String?
  measuredAt      DateTime @default(now())
  measuredBy      String   @default("system")
  createdAt       DateTime @default(now())

  @@index([forgeCap])
  @@index([measuredAt])
}

// Evidence lifecycle (§12.3): retention, tiered storage, legal hold, redaction class, and a
// tamper-evident Merkle chain-of-custody anchor. EvidenceAccess is the append-only access audit.
model EvidenceRecord {
  id             String    @id @default(cuid())
  bundleId       String    @unique
  ref            String
  contentHash    String
  prevAnchor     String?
  chainAnchor    String
  redactionClass String    @default("standard")
  tier           String    @default("hot")
  retentionUntil DateTime
  legalHold      Boolean   @default(false)
  packId         String?
  createdAt      DateTime  @default(now())
  purgedAt       DateTime?

  @@index([createdAt])
}

model EvidenceAccess {
  id        String   @id @default(cuid())
  recordId  String
  accessor  String
  reason    String   @default("")
  at        DateTime @default(now())

  @@index([recordId])
}

// Persisted, fleet-wide, scoped emergency safe mode (§11.7). Multiple scopes can be active at once.
model SafeModeState {
  id            String    @id @default(cuid())
  scopeType     String
  scopeValue    String    @default("")
  active        Boolean   @default(true)
  reason        String    @default("")
  activatedBy   String    @default("admin")
  activatedAt   DateTime  @default(now())
  deactivatedAt DateTime?
  deactivatedBy String?
  autoTriggered Boolean   @default(false)

  @@index([active])
}

// A temporary, expiring exception grant (§11.5 waiver/exception registry).
model Waiver {
  id                   String    @id @default(cuid())
  subject              String
  scope                String
  reason               String    @default("")
  compensatingControls String[]
  status               String    @default("active")
  grantedBy            String    @default("admin")
  grantedAt            DateTime  @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?

  @@index([status])
}

// A challenge to a cert decision within the 7-day window (§11.5 appeal workflow).
model Appeal {
  id                 String    @id @default(cuid())
  targetType         String    @default("cert_decision")
  targetId           String
  appellant          String
  grounds            String    @default("")
  originalApprover   String?
  status             String    @default("open")
  secondReviewer     String?
  reviewerDecision   String?
  resolutionNote     String    @default("")
  escalatedToFounder Boolean   @default(false)
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?

  @@index([status])
}

// A governed decision needing sign-off + its append-only signed decision journal (§11.5).
model ApprovalRequest {
  id                String    @id @default(cuid())
  kind              String
  subject           Json      @default("{}")
  summary           String    @default("")
  quorumRule        String    @default("single")
  requiredApprovers String[]
  status            String    @default("pending")
  createdBy         String    @default("system")
  createdAt         DateTime  @default(now())
  expiresAt         DateTime?
  resolvedAt        DateTime?
  resolution        String?

  @@index([status])
  @@index([kind])
}

model ApprovalDecision {
  id        String   @id @default(cuid())
  requestId String
  approver  String
  decision  String
  reason    String   @default("")
  timestamp DateTime @default(now())

  @@index([requestId])
}

// One recorded red-team probe run (ADR-0028). ADVISORY history only — a probe result never blocks,
// revokes, or changes a certification.
model AdversarialProbe {
  id             String   @id @default(cuid())
  scenarioId     String
  scenarioTitle  String   @default("")
  agent          String
  provider       String   @default("stub")
  verdict        String
  probesRun      Int      @default(0)
  resisted       Int      @default(0)
  capitulated    Int      @default(0)
  resistanceRate Float    @default(0)
  results        Json     @default("[]")
  ranBy          String   @default("operator")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}

// One recorded run of the golden regression suite (ADR-0033). History only — never changes the
// baseline, a score, or a certification.
model GoldenRun {
  id          String   @id @default(cuid())
  passed      Boolean
  total       Int      @default(0)
  matched     Int      @default(0)
  regressions Int      @default(0)
  results     Json     @default("[]")
  ranBy       String   @default("operator")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Owner's advisory remediation intent for a rubric dimension (Meta-Eval triage). ADVISORY ONLY —
// never changes a score, weight, or certification. One row per dimension.
model MetaEvalIntent {
  id        String   @id @default(cuid())
  dim       String   @unique
  intent    String
  note      String   @default("")
  updatedBy String   @default("owner")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pack {
  id                    String    @id @default(cuid())
  packId                String    @unique // "pack.greenstone.v1"
  name                  String
  version               String
  ownerVenture          String // FK → Venture.slug (the source of truth for the venture field)
  venture               Venture   @relation(fields: [ownerVenture], references: [slug])
  ownerHuman            String
  phiRequired           Boolean   @default(false)
  complianceFlags       String[]
  integratedRunsAllowed Boolean   @default(false)
  executionModeDefault  String    @default("sandbox")
  narrativeModeDefault  String    @default("protected")
  locale                String    @default("en")
  rubricProfile         String
  yamlPath              String
  yamlHash              String
  signedBy              String? // owner_human who ratified
  signedAt              DateTime?
  supersedesPackId      String? // the pack version this one replaces (edit → new version)

  scenarios     Scenario[]
  runs          Run[]
  readinessGate ReadinessGate?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([packId, version])
  @@index([ownerVenture])
}

model Scenario {
  id                   String   @id @default(cuid())
  scenarioId           String   @unique // "scn.gs.src.001"
  packId               String
  pack                 Pack     @relation(fields: [packId], references: [id])
  title                String
  tier                 String // "foundational" | "intermediate" | "advanced_crisis"
  testedAgentVillageId String
  testedForgeCaps      String[]
  trainingDomains      String[]
  seed                 Int
  yamlPath             String
  yamlHash             String
  sloSeconds           Int
  complianceChecks     String[]
  isGolden             Boolean  @default(false) // Golden Benchmark (v1.2)

  runs Run[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packId])
  @@index([testedAgentVillageId])
  @@index([tier])
  @@index([isGolden])
}

model ReadinessGate {
  id                       String   @id @default(cuid())
  packId                   String   @unique
  pack                     Pack     @relation(fields: [packId], references: [id])
  tierThresholds           Json // {F: 0.70, I: 0.80, AC: 0.85}
  cognitiveAggregateMin    Float    @default(0.75)
  blindModePct             Float    @default(0.25)
  arcFragmentationAutoFail Boolean  @default(true)
  complianceRequirePass    Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// RUN & EXECUTION
// ═══════════════════════════════════════════════════════════════

model Run {
  id         String   @id @default(cuid())
  runId      String   @unique // ULID
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id])
  packId     String
  pack       Pack     @relation(fields: [packId], references: [id])
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id])

  executionMode String // "sandbox" | "integrated"
  narrativeMode String // "protected" | "integrated"
  blindMode     Boolean @default(false)

  status    String // "pending" | "running" | "passed" | "failed" | "errored" | "cancelled"
  startedAt DateTime
  endedAt   DateTime?
  outcome   String?
  latencyMs Int?
  tokensUsed Int?
  costUsd   Float?

  ccbPreId  String?
  ccbPostId String?
  ccbPre    CCB?    @relation("RunCCBPre", fields: [ccbPreId], references: [id])
  ccbPost   CCB?    @relation("RunCCBPost", fields: [ccbPostId], references: [id])

  transcript        Json? // turn-by-turn
  evidenceBundleRef String? // S3 URI

  scorecard     Scorecard?
  softwareGaps  SoftwareGap[]
  villageOSGaps VillageOSGap[]
  traceEvents   TraceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scenarioId])
  @@index([agentId])
  @@index([status])
  @@index([startedAt])
}

model TraceEvent {
  id         String   @id @default(cuid())
  runId      String
  run        Run      @relation(fields: [runId], references: [id])
  timestamp  DateTime
  eventType  String // "turn_start" | "tool_call" | "framework_read" | ...
  phase      String // "setup" | "cold_open" | "turn" | "complication" | "resolution" | "wrap"
  turnNumber Int?
  payload    Json

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([timestamp])
}

// ═══════════════════════════════════════════════════════════════
// COGNITIVE CONTEXT BUNDLE (CCB)
// ═══════════════════════════════════════════════════════════════

model CCB {
  id             String   @id @default(cuid())
  snapshotId     String   @unique // ULID
  agentVillageId String
  phase          String // "pre" | "post"
  takenAt        DateTime
  contentHash    String // sha256

  game   Json
  mate   Json
  soul   Json
  breath Json
  fot    Json
  hfm    Json
  arc    Json
  echo   Json
  drift  Json
  ame    Json

  villageSchemaFingerprint String // fingerprint at capture time

  runsPre  Run[] @relation("RunCCBPre")
  runsPost Run[] @relation("RunCCBPost")

  createdAt DateTime @default(now())

  @@index([agentVillageId, phase])
  @@index([takenAt])
}

// Daily canary snapshot for drift detection (v1.2)
model CognitiveSnapshot {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  date          DateTime // truncated to day
  ccbSnapshotId String
  values        Json     @default("{}") // flat {signal: value} of the day's cognitive state
  deltas        Json     @default("{}") // {signal: delta vs. baseline (earliest) snapshot}
  driftMagnitude Float   @default(0) // L1 norm of the delta vector

  createdAt DateTime @default(now())

  @@unique([agentId, date])
  @@index([agentId])
}

// ═══════════════════════════════════════════════════════════════
// EVALUATION
// ═══════════════════════════════════════════════════════════════

model Scorecard {
  id    String @id @default(cuid())
  runId String @unique
  run   Run    @relation(fields: [runId], references: [id])

  // Performance dimensions
  p1Correctness        Float?
  p2Compliance         Boolean?
  p3ProcessFidelity    Float?
  p4TimeToResolution   Float?
  p5Escalation         Float?
  p6DocQuality         Float?
  p7CustomerExperience Float?
  p8CostDiscipline     Float?

  // Cognitive dimensions
  c1BreathCoherence         Float?
  c2SoulStability           Float?
  c3FotPressureManagement   Float?
  c4ArcNarrativeCoherence   String? // "gradual_drift" | "sudden_shift" | ...
  c5EchoRegretLoad          Float?
  c6HfmDriveBalance         Float?
  c7AmeReputationTrajectory Float?

  cognitiveAggregate Float?

  // Gate
  readinessGatePassed Boolean @default(false)
  autoFailReason      String? // "arc_fragmentation" | "compliance_violation" | ...

  turnAnnotations Json // [{turn, tag, detail}]
  remediationRecs Json? // [{rec, priority}]
  cohortComparison Json? // {role, agent_rank, cohort_size, percentile}

  createdAt DateTime @default(now())

  @@index([readinessGatePassed])
}

// ═══════════════════════════════════════════════════════════════
// GAPS
// ═══════════════════════════════════════════════════════════════

model SoftwareGap {
  id              String  @id @default(cuid())
  ticketId        String  @unique // "SF-GAP-4821"
  runId           String? // nullable: operation-cert VOID incidents are not tied to a scenario Run
  run             Run?    @relation(fields: [runId], references: [id])
  forge           String // "voiceforge" | "vaf" | "medlink-pro" | "cre-forge" | "funnelforge" | "capitalforge"
  module          String
  severity        String // "P0" | "P1" | "P2"
  summary         String
  detail          String
  proposedFix     String?
  linearUrl       String?
  linearId        String?
  status          String  @default("open") // "open" | "triaged" | "in_progress" | "fixed" | "wontfix"
  firstSeenRunId  String
  lastSeenRunId   String
  occurrenceCount Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([forge, severity, status])
  @@index([ticketId])
}

model VillageOSGap {
  id              String  @id @default(cuid())
  ticketId        String  @unique // "SF-VG-0142"
  runId           String
  run             Run     @relation(fields: [runId], references: [id])
  framework       String // "soul" | "fot" | "arc" | "echo" | "hfm" | "ame" | "breath" | "game" | "mate" | "drift"
  severity        String
  summary         String
  detail          String
  proposedFix     String?
  linearUrl       String?
  linearId        String?
  status          String  @default("open")
  occurrenceCount Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([framework, severity, status])
}

// ═══════════════════════════════════════════════════════════════
// CERTIFICATION
// ═══════════════════════════════════════════════════════════════

model AgentCert {
  id               String       @id @default(cuid())
  agentId          String
  agent            Agent        @relation(fields: [agentId], references: [id])
  forgeCap         String // "cre-forge.call_center.outbound_seller_outreach"
  tier             String // "foundational" | "intermediate" | "advanced_crisis"
  status           String // "active" | "expired" | "revoked" | "suspended"
  issuedAt         DateTime
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  certSnapshotId   String       @unique
  certSnapshot     CertSnapshot @relation(fields: [certSnapshotId], references: [id])

  lifecycleEvents CertLifecycleEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, forgeCap])
  @@index([status])
  @@index([expiresAt])
}

model DeptCert {
  id                       String       @id @default(cuid())
  departmentId             String
  department               Department   @relation(fields: [departmentId], references: [id])
  forgeContext             String
  tier                     String
  status                   String
  issuedAt                 DateTime
  expiresAt                DateTime
  revokedAt                DateTime?
  revocationReason         String?
  certSnapshotId           String       @unique
  certSnapshot             CertSnapshot @relation(fields: [certSnapshotId], references: [id])
  prerequisiteAgentCertIds String[]

  lifecycleEvents CertLifecycleEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, forgeContext])
  @@index([status])
}

model CertLifecycleEvent {
  id                String     @id @default(cuid())
  agentCertId       String?
  agentCert         AgentCert? @relation(fields: [agentCertId], references: [id])
  deptCertId        String?
  deptCert          DeptCert?  @relation(fields: [deptCertId], references: [id])
  event             String // "issued" | "renewed" | "revoked" | "suspended" | "reinstated" | "expired"
  timestamp         DateTime
  actor             String // user who triggered
  reason            String?
  snapshotIdAtEvent String?

  createdAt DateTime @default(now())

  @@index([agentCertId])
  @@index([deptCertId])
  @@index([event])
}

model CertSnapshot {
  id         String   @id @default(cuid())
  snapshotId String   @unique // "certsnap:7f3a...e9"
  certType   String // "agent_forge_cap" | "dept_forge_context"
  subject    String
  forgeCap   String?
  forgeContext String?
  tier       String
  issuedAt   DateTime
  expiresAt  DateTime

  pinnedVersions    Json // full version matrix
  evidenceBundleRef String // S3 URI
  signingKeyId      String
  signature         String // base64
  contentHash       String

  agentCert AgentCert?
  deptCert  DeptCert?

  createdAt DateTime @default(now())

  @@index([signingKeyId])
}

// ═══════════════════════════════════════════════════════════════
// AUTONOMY LADDER
// ═══════════════════════════════════════════════════════════════

model AutonomyEvent {
  id           String  @id @default(cuid())
  agentId      String
  agent        Agent   @relation(fields: [agentId], references: [id])
  fromLevel    String
  toLevel      String
  reason       String // "initial" | "time_based_promotion" | "compliance_violation_demotion" | "regression_demotion" | "manual_override"
  triggeredBy  String? // user or "system"
  runIdContext String? // run that triggered this
  approvalId   String? // if manual

  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
}

// Agent training proposal — a candidate prompt improvement from a weak run (ADR-0026).
// Approval-gated: never auto-applied. Approval promotes the prompt version + suspends old certs.
model TrainingProposal {
  id                    String    @id @default(cuid())
  agentId               String
  runId                 String? // run whose scorecard surfaced the weakness
  weakDims              String[] // e.g. ["p7_cx"]
  currentPromptVersion  String
  proposedPromptVersion String
  rationale             String
  proposedRefinement    String
  status                String    @default("proposed") // proposed | approved | rejected
  autoApplied           Boolean   @default(false) // always false — approval-gated
  reviewedBy            String?
  reviewedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([agentId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
// OBJECT REGISTRY & LINEAGE
// ═══════════════════════════════════════════════════════════════

model ObjectRegistryEntry {
  id               String    @id @default(cuid())
  urn              String    @unique // "urn:gc:village:agent:jennifer_adams"
  kind             String // "agent" | "department" | "forge_cap" | ...
  canonicalId      String
  metadata         Json
  tombstoned       Boolean   @default(false)
  tombstonedAt     DateTime?
  tombstonedBy     String?
  tombstonedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([tombstoned])
  @@index([canonicalId])
}

model LineageEdge {
  id           String @id @default(cuid())
  fromUrn      String
  toUrn        String
  relationType String // "produced_by" | "derived_from" | "pinned_to" | "evidenced_by" | "revoked_by" | "amends"
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([fromUrn])
  @@index([toUrn])
  @@index([relationType])
  @@index([fromUrn, toUrn, relationType])
}

// ═══════════════════════════════════════════════════════════════
// CONSTITUTION & GOVERNANCE
// ═══════════════════════════════════════════════════════════════

model Constitution {
  id                  String    @id @default(cuid())
  version             String    @unique // "v1.0.0"
  ratifiedAt          DateTime
  ratifiedBy          String
  yamlContent         String    @db.Text
  contentHash         String
  supersededByVersion String?
  supersededAt        DateTime?

  amendments ConstitutionalAmendment[]

  createdAt DateTime @default(now())

  @@index([version])
}

model ConstitutionalAmendment {
  id                  String       @id @default(cuid())
  amendmentId         String       @unique
  baseConstitutionId  String
  baseConstitution    Constitution @relation(fields: [baseConstitutionId], references: [id])
  proposedAt          DateTime
  proposedBy          String
  coolingPeriodEndsAt DateTime
  ratifiedAt          DateTime?
  ratifiedBy          String?
  diffYaml            String       @db.Text
  impactAnalysis      Json? // affected certs etc.
  status              String // "proposed" | "in_cooling" | "ratified" | "withdrawn" | "vetoed"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
// SCHEMA FINGERPRINT (Village drift detection)
// ═══════════════════════════════════════════════════════════════

model VillageFingerprint {
  id            String   @id @default(cuid())
  fingerprint   String   @unique
  capturedAt    DateTime
  paths         Json // which structural paths contributed
  isCurrent     Boolean  @default(false)
  flaggedByUser Boolean  @default(false)

  @@index([isCurrent])
}

// ═══════════════════════════════════════════════════════════════
// SCENARIO BANK — reviewable scenario library + ingestion lifecycle
// ═══════════════════════════════════════════════════════════════
// Separate from the runtime `Scenario` table. Nothing here reaches certification automatically:
// aiDrafted → human-approved draft → committed (an explicit human action). Legacy scenarios are
// backfilled as status=committed / sourceType=legacy with their ids preserved.
model BankScenario {
  id                 String    @id @default(cuid())
  publicId           String    @unique // "draft_{ulid}" | "legacy_{scenarioId}"
  scenarioId         String?   @unique // "scn.gs.src.001" once committed; null while draft
  title              String
  pack               String
  family             String
  tier               String
  situation          String    @default("")
  expectedBehaviors  String[]
  adversarialTactics String[]
  jurisdictionFlags  String[]
  status             String    @default("draft") // draft|in_review|committed|rejected|archived
  aiDrafted          Boolean   @default(false)
  sourceType         String    @default("manual") // legacy|manual|paste|document|web|youtube|video
  sourceRef          String? // filename / url
  sourceExcerpt      String?
  createdBy          String    @default("unknown")
  reviewedBy         String?
  reviewedAt         DateTime?
  version            Int       @default(1)
  supersedesId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([pack])
  @@index([family])
  @@index([tier])
  @@index([sourceType])
}

// ============================================================================
// Forge Operation Certification (Rev 2, agent × forge × module) — ADDITIVE, separate from the
// 8-dimension DOMAIN rubric and its certs (AgentCert/DeptCert), which are untouched.
// ============================================================================

// The curriculum an operation cert BINDS to: the instruction set for a forge module, authored by
// The Office; SimForge tests an agent against it. A cert records the instruction_version,
// forge_api_version, and content_hash it was earned under (change → re-cert; hash mismatch → VOID).
model ForgeInstructionSet {
  id                 String   @id @default(cuid())
  forgeId            String
  moduleId           String
  instructionVersion String // semver
  forgeApiVersion    String // semver
  authoredBy         String
  authoredAt         DateTime @default(now())
  contentHash        String
  // The module's never-do list. Empty = no never-do rules (never_do_adherence is genuinely n/a);
  // non-empty = the never_do_violation dimension must be tested (an untested one is a coverage hole).
  neverDo            Json     @default("[]")
  createdAt          DateTime @default(now())

  @@index([forgeId])
  @@index([moduleId])
}

// An operation certification at agent × forge × module granularity. One table, two unit types:
//   Unit A (agent_operation):    agentId × forgeId × moduleId
//   Unit B (department_context): departmentId × forgeId × forgeContext × ventureContext
// operationRubricVersion is SEPARATE from and independent of the domain rubric_version (required,
// not optional). `state` is the distinct 7-state machine — never_certified/failed/stale are never a
// low score. operationRubricResults is a NAMED LIST (not fixed dimension columns). The DENOMINATOR
// (functionsCertified of functionsInModule) travels on every Unit A result.
/// An operation battery IN FLIGHT. Before this table SimForge held no record of a run
/// between curriculum hand-over and gate-result, so a hung battery produced no row, no
/// verdict and no error - and the Office's TIMEOUT -> in_training mapping was unreachable.
/// An open row (endedAt IS NULL) past its window is what makes a hung run observable.
model OperationRun {
  id String @id @default(cuid())

  /// Correlates to the Office curriculum submission. Unique: the Office reads a verdict
  /// BY this ref, and two runs sharing one ref make the answer ambiguous.
  runRef String @unique
  unit   String // "A" (agent x forge x module) | "B" (department x forge)

  forgeId      String
  moduleId     String?
  agentId      String?
  departmentId String?

  instructionContentHash String // the basis; a verdict whose basis is unknown cannot be recomputed
  rubricKind             String // operation | domain - never a merged score
  rubricVersion          String

  startedAt DateTime  @default(now())
  /// NULL = still open. This column, and only this column, is what "did not finish" means.
  endedAt   DateTime?
  /// Stored per-run so a run is judged against the window it STARTED under; changing the
  /// default must not retroactively time out runs that were inside their own window.
  windowMinutes Int @default(180)

  /// Set on finish (from the cert state) or by the timeout sweep. NULL while legitimately
  /// in progress - an unfinished run has no verdict.
  verdict    String?
  /// When the sweep resolved this run to TIMEOUT. Distinct from endedAt, which means the
  /// run produced a result; a timed-out run never did.
  timedOutAt DateTime?

  /// A timed-out run carries NO score - zero would be a claim about the agent, not the run.
  score               Float?
  threshold           Float?
  certifiedTier       String?
  scenarioCount       Int     @default(0)
  coverageDenominator Int     @default(0)

  createdAt DateTime @default(now())

  @@index([unit])
  @@index([forgeId])
  @@index([moduleId])
  @@index([agentId])
  @@index([departmentId])
  @@index([endedAt])
  @@index([verdict])
}

model OperationCertification {
  id                     String    @id @default(cuid())
  unitType               String // agent_operation | department_context
  state                  String // certified|stale_instructions|stale_forge|in_training|never_certified|failed|revoked
  forgeId                String
  instructionVersion     String // semver, earned under
  forgeApiVersion        String // semver, earned under
  instructionContentHash String // mismatch at run → VOID
  operationRubricVersion String // semver, SEPARATE from domain rubric_version — required

  // Unit A (nullable for Unit B rows)
  agentId               String?
  moduleId              String?
  functionsCertified    Int?
  functionsInModule     Int? // DENOMINATOR
  maxCertifiedTrustTier String? // auto_execute | propose | suggest
  perScenarioClass      Json? // { scenario_class: verdict }
  operationRubricResults Json? // NAMED LIST: [{dimension, verdict, score?, threshold?}]
  rubricDimensionSpread Float? // collapse check
  failureModesObserved  Json?
  versionSensitivity    Json? // {module: [major|minor|patch]} (Rev 2 Q4)
  expiresAt             DateTime?

  // Unit B (nullable for Unit A rows)
  departmentId               String?
  forgeContext               String?
  ventureContext             String?
  escalationPathVerified     Boolean?
  complianceCouplingVerified Boolean?

  createdAt  DateTime  @default(now())
  reviewedBy String?
  reviewedAt DateTime?

  @@index([unitType])
  @@index([state])
  @@index([forgeId])
  @@index([agentId])
  @@index([moduleId])
  @@index([departmentId])
}

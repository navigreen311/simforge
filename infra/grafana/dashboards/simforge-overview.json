{
  "uid": "simforge-overview",
  "title": "SimForge \u2014 Governance Overview",
  "tags": [
    "simforge"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Scenario runs (rate by status)",
      "datasource": {
        "type": "prometheus",
        "uid": "simforge-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "simforge-prom"
          },
          "expr": "sum(rate(simforge_runs_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Readiness gate outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "simforge-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "simforge-prom"
          },
          "expr": "sum(increase(simforge_readiness_gate_total[1h])) by (passed)",
          "legendFormat": "passed={{passed}}",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Open gaps",
      "datasource": {
        "type": "prometheus",
        "uid": "simforge-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "simforge-prom"
          },
          "expr": "sum(simforge_gaps_open)",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Certs issued (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "simforge-prom"
      },

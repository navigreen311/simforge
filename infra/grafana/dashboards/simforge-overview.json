          "datasource": {
            "type": "prometheus",
            "uid": "simforge-prom"
          },
          "expr": "sum(increase(simforge_certs_issued_total[1h]))",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "PDP cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "simforge-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"

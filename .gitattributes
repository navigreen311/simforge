# Normalize line endings to LF in the repo (critical for shell scripts on Windows)
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.prisma text eol=lf
*.md   text eol=lf

# Binaries
*.png binary
*.jpg binary
*.pdf binary
*.ico binary

{
  "name": "simforge",
  "version": "1.0.0",
  "private": true,
  "description": "Tier-1 governance & certification platform for Village OS agents",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @simforge/db generate",
    "db:migrate": "pnpm --filter @simforge/db migrate",
    "db:seed": "pnpm --filter @simforge/db seed",
    "bootstrap": "bash scripts/bootstrap.sh",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  }
}

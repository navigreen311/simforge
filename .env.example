# ─────────────────────────────────────────────────────────────
# SimForge environment (dev). Copy to `.env` and fill placeholders.
# NEVER commit `.env`. Staging/prod read from AWS Secrets Manager.
# ─────────────────────────────────────────────────────────────

# --- Core datastores ---
DATABASE_URL=postgresql://simforge:simforge@localhost:5432/simforge?schema=public
REDIS_URL=redis://localhost:6379/0

# --- Evidence storage (dev = local filesystem) ---
S3_BUCKET=evidence-local
S3_REGION=us-west-2
EVIDENCE_LOCAL_PATH=./evidence-local

# --- Village OS coupling (read-only). Dev = local synthetic fixture tree ---
VILLAGE_DATA_PATH=./village-data-local/VillageData
# The Village's own config.yaml - where its agents' model is declared (ADR-0061). SimForge reads
# it to check that the examiner IS the production model; without it a battery refuses, because
# "could not see production" is not "matched production".
VILLAGE_CONFIG_PATH=
# The Village's live agent database (ADR-0065). IDENTITY is read from here, not from the
# VillageData tree: the tree is a snapshot, and it has been three weeks stale describing a
# population that was not running. A path that is set and missing is LOUD - every identity
# lookup raises - because a silent fall back to the snapshot is the defect.
# THE DEFAULT BELOW DOES NOT EXIST IN A FRESH CHECKOUT, and a default is still a value: this read
# as "configured" for two days while pointing at nothing. Point it at the Village's real database,
# e.g. C:/Users/<you>/village1.0.2-recovered/village1.0.2/village.db, and check
# `/api/version` -> launch_environment.paths.village_db_path.resolves before running a battery.
VILLAGE_DB_PATH=./village-data-local/village.db

# The examiner (ADR-0061). Certification runs on the model Village agents run on, pinned by
# DIGEST - a tag moves, and `phi4:latest` re-pulled over different weights is the same string and
# a different model. Read the digest once from GET $OLLAMA_BASE_URL/api/tags.
EXAM_MODEL_TAG=phi4:latest
#
# PREFIX IT `sha256:`. Ollama's /api/tags returns bare hex and `llm_client.py` writes
# `f"sha256:{digest}"`, so a bare pin here compares unequal and reports EXAMINER_TAG_MOVED - a
# drift event that never happened. Example shape (this is phi4:latest as pulled 17 Sep 2026):
#   EXAM_MODEL_DIGEST=sha256:ac896e5b8b34a1f4efa7b14d7520725140d5512484457fab45d2a4ea14c69dba
EXAM_MODEL_DIGEST=
VILLAGE_OS_VERSION_FINGERPRINT=dev-fingerprint

# --- LLM providers (ADR-0008) ---
# Agent runtime + judge providers routed independently: stub (default) | ollama | anthropic
LLM_PROVIDER=stub
LLM_JUDGE_PROVIDER=stub
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_AGENT_MODEL=llama3.1:8b
OLLAMA_JUDGE_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
ANTHROPIC_AGENT_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_JUDGE_MODEL=claude-3-5-sonnet-20241022
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Hermetic-cache: off | read | record | replay_strict
LLM_CACHE_MODE=off
LLM_CACHE_DIR=./tests/fixtures/llm_cache
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# --- Auth (Clerk). Dev may use dev-bypass; staging/prod require real keys ---
AUTH_MODE=dev-bypass
CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY_HERE
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY_HERE

# --- The Office bridge (ADR-0046) ---
# A TENANT credential, not a user token, and checked independently of AUTH_MODE: under
# dev-bypass every principal is a full-access admin, so an adapter leaning on AUTH_MODE
# would serve the agent-facing surface to any caller. Empty = not onboarded, and the
# /office router is not mounted at all — The Office reads the resulting 404 as "serves no
# manifest", which is the truth. The same value goes in theoffice/.env as SIMFORGE_TOKEN.
OFFICE_TENANT_TOKEN=

# --- Signing (dev = local Ed25519 stub — NEVER use stub in prod) ---
HSM_PROVIDER=stub
SIMFORGE_ROOT_KEY_ID=dev-root
SIMFORGE_SIGNING_PRIVATE_KEY_PATH=./signing-keys/dev-ed25519.pem

# --- Gap routing (dev = skip posting) ---
LINEAR_API_KEY=
# Inbound webhook HMAC secret. Empty = dev (accept-with-warning); set in prod to enforce.
LINEAR_WEBHOOK_SECRET=

# --- Observability (dev = off) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Forge sandbox URLs (dev = local stub servers) ---
FORGE_VOICEFORGE_SANDBOX_URL=http://localhost:9101
FORGE_VAF_SANDBOX_URL=http://localhost:9102
FORGE_MEDLINK_PRO_SANDBOX_URL=http://localhost:9103
FORGE_CRE_FORGE_SANDBOX_URL=http://localhost:9104
FORGE_FUNNELFORGE_SANDBOX_URL=http://localhost:9105
FORGE_CAPITALFORGE_SANDBOX_URL=http://localhost:9106

# --- Budget cap (USD/month) ---
SIMFORGE_BUDGET_SANDBOX_MONTHLY_USD=50

# --- App ---
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
